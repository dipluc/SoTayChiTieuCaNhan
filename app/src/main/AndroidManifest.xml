<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for picking receipt images from Gallery -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalExpenseManager">

        <!-- Launcher Activity: LoginActivity (TV4) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity (TV4) -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MainActivity (TV1 / TV2) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AddEditTransactionActivity (TV1) -->
        <activity
            android:name=".activities.AddEditTransactionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- CategoryActivity (TV2) -->
        <activity
            android:name=".activities.CategoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- StatisticsActivity (TV3) -->
        <activity
            android:name=".activities.StatisticsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- SettingsActivity (TV4) -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>